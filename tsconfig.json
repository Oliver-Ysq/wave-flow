{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "examples/**/*.ts", "src-tauri/web/**/*.ts", "src-tauri/web/**/*.tsx"],
  "exclude": ["src/harness/templates"]
}
