{
  "name": "wave-flow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "wave-flow": "./src/cli/main.ts"
  },
  "scripts": {
    "test": "bun test",
    "check": "tsc --noEmit",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "web:preview": "vite preview --config web/vite.config.ts",
    "desktop:prepare": "bun run web:build && bun build src/daemon/daemon-main.ts --compile --outfile src-tauri/binaries/wave-flow-daemon-aarch64-apple-darwin && cp src-tauri/binaries/wave-flow-daemon-aarch64-apple-darwin src-tauri/binaries/wave-flow-aarch64-apple-darwin && bun build src/desktop/bridge.ts --compile --outfile src-tauri/binaries/wave-flow-desktop-bridge-aarch64-apple-darwin && chmod 755 src-tauri/binaries/wave-flow-aarch64-apple-darwin",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.2",
    "@types/bun": "latest",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.1",
    "ajv": "^8.17.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  },
  "dependencies": {
    "@agentclientprotocol/codex-acp": "2.2.2",
    "@agentclientprotocol/sdk": "1.8.0",
    "@mariozechner/pi-agent-core": "0.73.1",
    "@mariozechner/pi-ai": "0.73.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@opentelemetry/api": "1.9.1",
    "@tauri-apps/api": "^2.12.3"
  }
}
