{
  "name": "wave-flow",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "bun test",
    "check": "tsc --noEmit",
    "web:dev": "vite --config src-tauri/web/vite.config.ts",
    "web:build": "vite build --config src-tauri/web/vite.config.ts",
    "web:preview": "vite preview --config src-tauri/web/vite.config.ts",
    "desktop:prepare": "bun run web:build && bun build src/desktop/engine-main.ts --compile --outfile src-tauri/binaries/wave-flow-desktop-engine-aarch64-apple-darwin",
    "desktop:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "desktop:build": "tauri build && bun run scripts/sign-macos-app.ts"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.2",
    "@types/bun": "latest",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/react-mentions": "^4.4.1",
    "@vitejs/plugin-react": "^5.1.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.94.0",
    "@agentclientprotocol/codex-acp": "2.2.2",
    "@agentclientprotocol/sdk": "1.8.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@pierre/diffs": "^1.5.2",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "ajv": "^8.17.1",
    "react-markdown": "^10.1.0",
    "react-mentions": "^4.4.10",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  }
}
