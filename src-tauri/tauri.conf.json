{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wave Flow",
  "version": "0.2.4",
  "identifier": "com.wave-flow.desktop",
  "build": {
    "beforeDevCommand": "bun run desktop:prepare && bun run web:dev",
    "beforeBuildCommand": "bun run desktop:prepare",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "./web/dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Wave Flow", "titleBarStyle": "Overlay", "hiddenTitle": true, "width": 1280, "height": 860, "minWidth": 700, "minHeight": 700, "visible": false }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.png"],
    "externalBin": ["binaries/wave-flow-desktop-engine"],
    "macOS": { "minimumSystemVersion": "12.0" }
  }
}
